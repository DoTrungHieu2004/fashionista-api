NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ---- Logging ----

LOG_DIR=./logs
LOG_TO_FILE=true
# 'daily' | 'hourly' | 'off'  (off = size-only rotation)
LOG_ROTATION_FREQUENCY=daily
# Rotate mid-day if a file exceeds this size ('20m', '1g', '500k', …)
LOG_ROTATION_SIZE=20m
# Max files kept per stream (app.*.jsonl / error.*.jsonl)
LOG_RETENTION_COUNT=14

# ---- Firebase Admin ----

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Private key from the service account JSON. Escape newlines as \n in .env.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Optional: only needed if the Admin SDK must use Realtime Database or Storage.
# FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com